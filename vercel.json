{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/post?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "/blog.html",
      "permanent": false
    },
    {
      "source": "/quiz",
      "destination": "/quiz.html",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.houseoffigs.org"
        }
      ],
      "destination": "https://houseoffigs.org/$1",
      "permanent": true
    }
  ]
}
