{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.houseoffigs.org"
        }
      ],
      "destination": "https://houseoffigs.org/$1",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/podcast.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/podcast",
      "destination": "/",
      "permanent": false
    }
  ]
}
