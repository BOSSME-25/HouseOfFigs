rules_version = '2';

// Blog/site images uploaded from the admin dashboard.
// Public read (they render on the site); writes only by the same admin
// allow-list that gates the dashboard (see ALLOWED_EMAILS in admin.js).
service firebase.storage {
  match /b/{bucket}/o {
    match /blog/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['bethany@houseoffigs.org', 'emily@houseoffigs.org']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.token.email in ['bethany@houseoffigs.org', 'emily@houseoffigs.org'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
